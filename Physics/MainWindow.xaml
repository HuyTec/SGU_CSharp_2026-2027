<Window x:Class="Physics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Physics"
        Title="Physics Verlet Demo"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#0f172a">
        <Border Margin="12"
                CornerRadius="12"
                BorderBrush="#334155"
                BorderThickness="1.5">
            <local:SimulationCanvas x:Name="SimulationCanvas"
                                   Background="#111827" />
        </Border>
    </Grid>
</Window>
